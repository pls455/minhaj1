rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminPath(uid) { return /databases/$(database)/documents/admins/$(uid); }
    function currentAdminExists() { return signedIn() && exists(adminPath(request.auth.uid)); }
    function currentAdmin() { return get(adminPath(request.auth.uid)); }
    function isAdmin() { return currentAdminExists() && currentAdmin().data.active == true; }
    function adminRole() { return isAdmin() ? currentAdmin().data.role : ""; }
    function isReviewer() { return isAdmin() && (adminRole() == "reviewer" || adminRole() == "content_admin" || adminRole() == "superadmin" || adminRole() == "super_admin" || adminRole() == "admin"); }
    function isContentAdmin() { return isAdmin() && (adminRole() == "content_admin" || adminRole() == "superadmin" || adminRole() == "super_admin" || adminRole() == "admin"); }
    function isSuperAdmin() { return isAdmin() && (adminRole() == "superadmin" || adminRole() == "super_admin" || adminRole() == "admin"); }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }
    match /branches/{branchId} { allow read: if true; allow create, update, delete: if isSuperAdmin(); }
    match /categories/{categoryId} { allow read: if true; allow create, update, delete: if isSuperAdmin(); }
    match /subjects/{subjectId} { allow read: if true; allow create, update, delete: if isContentAdmin(); }
    match /resources/{resourceId} { allow read: if true; allow create, update, delete: if isContentAdmin(); }
    match /foundations/{foundationId} { allow read: if true; allow create, update, delete: if isContentAdmin(); }

    // Google Drive Source Registry: reviewers can inspect the queue; content admins can manage it.
    match /sourceRegistry/{sourceId} {
      allow read: if isReviewer();
      allow create, update, delete: if isContentAdmin();
    }

    match /suggestions/{suggestionId} {
      allow create: if true;
      allow read, update: if isReviewer();
      allow delete: if false;
    }
    match /adminLogs/{logId} { allow read, create: if isSuperAdmin(); allow update, delete: if false; }
    match /templates/{templateId} { allow read, create, update, delete: if isContentAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}